# Copy to .env, fill in both values, then run: docker compose up
# The folder with your memes (mounted read-only):
MEMES_DIR=./my-memes
# Protects the web app on your network (16+ characters). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# then open http://<this machine>:8765/?token=<token> once on each device.
MEMESEEKS_TOKEN=
