# Settings for scripts/sync.py and scripts/remote.sh (maintainer tooling for a remote GPU machine).
# Copy to .memeseeks-dev.env (gitignored) and fill in. Not needed to use memeseeks itself.
# An ssh host alias from ~/.ssh/config:
MEMESEEKS_HOST=my-gpu-box
# A folder under the remote home, must end in /memeseeks:
MEMESEEKS_REMOTE=work/memeseeks
# Local folder with my-memes/ and queries.csv:
MEMESEEKS_LOCAL_DATA=/path/to/private-memes-data
